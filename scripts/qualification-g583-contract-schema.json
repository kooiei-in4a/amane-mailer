{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kooiei-in4a/amane-mailer/schemas/qualification-g583-contract-schema.json",
  "title": "G583 S5-A qualification contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/winDockerPlatformContract"},
          {"$ref": "#/$defs/linuxDockerPlatformContract"},
          {"$ref": "#/$defs/mig03Contract"}
        ]
      }
    }
  },
  "$defs": {
    "platformArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "requiredFields", "selectedManifestRule"],
      "properties": {
        "authority": {"const": "candidate-binding"},
        "requiredFields": {
          "const": ["candidateId", "releaseCommitSha", "ociIndexDigest", "selectedManifestDigest"]
        },
        "selectedManifestRule": {"const": "must-match-selected-oci-descriptor"}
      }
    },
    "ciArtifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "requiredFields"],
      "properties": {
        "authority": {"const": "candidate-binding"},
        "requiredFields": {
          "const": ["candidateId", "releaseCommitSha", "ociIndexDigest"]
        }
      }
    },
    "winDockerPlatformContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "laneVariant", "contractVersion", "hostPlatform", "dockerEngineOS", "containerPlatform", "artifactIdentity"],
      "properties": {
        "scenarioId": {"const": "G583-MIG-01"},
        "laneVariant": {"const": "win-docker"},
        "contractVersion": {"const": "g583-s5a-platform-v1"},
        "hostPlatform": {"const": "windows-x64"},
        "dockerEngineOS": {"const": "linux"},
        "containerPlatform": {"const": "linux/amd64"},
        "artifactIdentity": {"$ref": "#/$defs/platformArtifactIdentity"}
      }
    },
    "linuxDockerPlatformContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "laneVariant", "contractVersion", "hostPlatform", "dockerEngineOS", "containerPlatform", "artifactIdentity"],
      "properties": {
        "scenarioId": {"const": "G583-MIG-02"},
        "laneVariant": {"const": "linux-docker"},
        "contractVersion": {"const": "g583-s5a-platform-v1"},
        "hostPlatform": {"enum": ["linux-x64", "linux-arm64"]},
        "dockerEngineOS": {"const": "linux"},
        "containerPlatform": {"enum": ["linux/amd64", "linux/arm64"]},
        "artifactIdentity": {"$ref": "#/$defs/platformArtifactIdentity"}
      }
    },
    "mig03Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "laneVariant", "contractVersion", "artifactIdentity"],
      "properties": {
        "scenarioId": {"const": "G583-MIG-03"},
        "laneVariant": {"const": "ci-auto"},
        "contractVersion": {"const": "g583-mig03-ci-auto-v1"},
        "artifactIdentity": {"$ref": "#/$defs/ciArtifactIdentity"}
      }
    }
  }
}
