<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Amane.Mailer</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <IsTrimmable>true</IsTrimmable>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050;IL2104</WarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Communication.Email" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="MailKitLite" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="MimeKitLite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amane.Mailer.Contracts\Amane.Mailer.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Amane.Mailer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\Migrations\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The static-web-assets SDK records each asset's Last-Modified value in its
    generated endpoint manifest. Compressed assets are created during publish,
    so their filesystem timestamp otherwise changes on every release build.
    Release image builds opt in with a fixed timestamp; ordinary development
    builds keep the SDK default behavior.
  -->
  <Target Name="NormalizeDeterministicStaticWebAssetSourceTimestamps"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          Condition="'$(DeterministicStaticWebAssetsTimestamp)' != ''">
    <ItemGroup>
      <_DeterministicStaticWebAssetSourceFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
    </ItemGroup>
    <Touch Files="@(_DeterministicStaticWebAssetSourceFiles)"
           Time="$(DeterministicStaticWebAssetsTimestamp)"
           AlwaysCreate="false" />
  </Target>

  <Target Name="NormalizeDeterministicStaticWebAssetTimestamps"
          AfterTargets="GenerateBuildCompressedStaticWebAssets"
          BeforeTargets="ResolveBuildCompressedStaticWebAssets"
          Condition="'$(DeterministicStaticWebAssetsTimestamp)' != ''">
    <Touch Files="@(_CompressedStaticWebAssets)"
           Time="$(DeterministicStaticWebAssetsTimestamp)"
           AlwaysCreate="false" />
  </Target>

  <Target Name="NormalizeDeterministicPublishStaticWebAssetTimestamps"
          AfterTargets="GeneratePublishCompressedStaticWebAssets"
          BeforeTargets="ResolvePublishCompressedStaticWebAssets"
          Condition="'$(DeterministicStaticWebAssetsTimestamp)' != ''">
    <ItemGroup>
      <_DeterministicStaticWebAssetFiles Include="@(StaticWebAsset)" />
      <_DeterministicStaticWebAssetFiles Include="@(_CompressedStaticWebAssets)" />
      <_DeterministicStaticWebAssetFiles Include="@(_CompressedStaticWebAssetsForPublish)" />
    </ItemGroup>
    <Touch Files="@(_DeterministicStaticWebAssetFiles)"
           Time="$(DeterministicStaticWebAssetsTimestamp)"
           AlwaysCreate="false" />
  </Target>

</Project>
