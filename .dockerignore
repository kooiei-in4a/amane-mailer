# Keep Docker build contexts small and free of local/private data.
.git/
.github/
.agents/
.codex/
.vs/
docs/
tests/
artifacts/
.artifacts/
.env
.env.*
*.env
*.user
# Deploy-time secrets and local databases — never include in build context
infra/deploy/data/
infra/deploy/tenants.json
infra/deploy/secrets/
infra/deploy/config/platform-sender/
*.db
*.db-wal
*.db-shm

!Directory.Build.props
!Directory.Build.targets
!Directory.Packages.props
!src/
!src/**
!config/
!config/mailer/
!config/mailer/tenants.example.json
!config/mailer/tenants.local-acs.json.example
!config/mailer/tenants.schema.json

# Private tenant config, deploy keys, backups, and rehearsal artifacts — never in build context
config/mailer/tenants.local*.json
config/mailer/tenants.production*.json
infra/deploy/keys/
infra/deploy/rclone/
infra/deploy/restore/
*.db.age
infra/deploy/compose.acs-drill.yml
infra/deploy/compose.mail-05a-client.yml
infra/deploy/compose.worker-disabled.yml
infra/deploy/mail-05a-work/
infra/deploy/tenants.acs-drill.json
infra/deploy/mail-05a-acs-drill.input.json
infra/deploy/drills/mail-05a-acs-drill.input.json

# Keep generated build outputs excluded after the source re-include rules.
**/bin/
**/bin/**
**/obj/
**/obj/**
