# Copy to .env on a VPS host and replace only the deployment placeholders below.
# This profile is the managed-v2 reference path. It intentionally has no:
#   MAILER_TENANTS_HOST_PATH / MAILER_TENANTS_CONTAINER_PATH
#   MAIL_SERVICE_TOKEN / MAIL_SERVICE_TOKEN_DEVELOP / MAIL_SERVICE_TOKEN_STAGING /
#   MAIL_SERVICE_TOKEN_PRODUCTION / MAILER_PROVIDER
# Do not add those legacy/manual inputs to this file.

# ── Required: project and published image ───────────────────────────────────
COMPOSE_PROJECT_NAME=amane-mailer-vps
MAILER_IMAGE_REPOSITORY=ghcr.io/YOUR_GITHUB_ORG/amane-mailer
MAILER_IMAGE_TAG=sha-replace-with-published-git-sha
MAILER_PULL_POLICY=always

# ── Required: managed SQLite state and runtime resources ────────────────────
# PR3 full instance backup boundary is MAILER_DATA_PATH: mailer.db,
# secrets/acs/acs_connection_string, and attachment-spool/committed.
MAILER_DATA_PATH=./data
MAILER_CONNECTION_STRING=Data Source=/app/data/mailer.db
MAILER_MEM_LIMIT=512m
MAILER_CPUS=1.0
MAILER_STOP_GRACE_PERIOD=120s
MAILER_NETWORK_NAME=amane_mailer
MAILER_NETWORK_ALIAS=mailer

# ── Required: health and logging defaults ────────────────────────────────────
MAILER_HEALTHCHECK_INTERVAL=30s
MAILER_HEALTHCHECK_TIMEOUT=5s
MAILER_HEALTHCHECK_RETRIES=5
MAILER_HEALTHCHECK_START_PERIOD=20s
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ── Protected provider/bounce file locations ────────────────────────────────
# The browser-setup managed-v2 ACS authority is stored under MAILER_DATA_PATH.
# This host path is a read-only compatibility/manual-registration mount, not a
# second provider-secret authority and not part of the full Mailer archive.
# No provider secret is an environment tenant token.
MAILER_ACS_SECRET_HOST_PATH=./secrets/acs
MAILER_BOUNCE_QUEUE_SECRET_HOST_PATH=./secrets/bounce-queue
MAILER_BOUNCE_INGESTION=off
MAILER_BOUNCE_QUEUE_NAME=

# Keep metrics disabled until a private scrape bearer is provisioned. If enabled,
# set MAILER_METRICS_BEARER_TOKEN only in this private host .env.
MAILER_METRICS_ENABLED=false

# ── Full instance backup (PR3; configure before scheduling) ────────────────
# The archive contains only managed SQLite state, the canonical provider secret,
# and attachment-spool/committed. Keep the age identity outside this host and
# outside the backup remote; set the recipient public key here.
MAILER_BACKUP_ENCRYPTION_PUBLIC_KEY=replace-with-age-recipient-public-key
MAILER_BACKUP_RCLONE_REMOTE=remote:bucket-or-prefix/mailer/
MAILER_BACKUP_RCLONE_CONFIG_PATH=./rclone/rclone.conf
MAILER_BACKUP_REQUIRE_OFFSITE=true
MAILER_BACKUP_PING_URL=
MAILER_COMPOSE_FILE=compose.yml:compose.vps-dogfood.yml

# ── VPS Caddy edge ──────────────────────────────────────────────────────────
MAILER_PUBLIC_HOSTNAME=mailer.example.invalid
MAILER_MANAGEMENT_ALLOWED_CIDRS=192.0.2.0/24
MAILER_VPS_PROXY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
MAILER_VPS_CADDYFILE_PATH=./Caddyfile.vps-dogfood
MAILER_VPS_PROXY_NETWORK_SUBNET=172.30.0.0/28
MAILER_VPS_PROXY_IPV4_ADDRESS=172.30.0.2
MAILER_VPS_MAILER_IPV4_ADDRESS=172.30.0.3
MAILER_VPS_HTTP_BIND=0.0.0.0
MAILER_VPS_HTTPS_BIND=0.0.0.0
MAILER_VPS_HTTP_PORT=80
MAILER_VPS_HTTPS_PORT=443
