# Shared-edge managed-v2 example for infra/deploy/compose.shared-edge.yml.
# Copy to a private deploy-host .env and replace deployment-specific values.
# The shared reverse proxy / TLS edge is owned outside this Compose project.
# Do not commit the real .env file.

# ── Project and image ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=amane-mailer-staging
MAILER_IMAGE_REPOSITORY=ghcr.io/YOUR_GITHUB_ORG/amane-mailer
MAILER_IMAGE_TAG=sha-replace-with-published-git-sha
MAILER_IMAGE_REFERENCE=ghcr.io/YOUR_GITHUB_ORG/amane-mailer@sha256:replace-with-approved-digest
MAILER_PULL_POLICY=never

# ── Managed SQLite state and runtime resources ───────────────────────────────
MAILER_DATA_PATH=./data
MAILER_CONNECTION_STRING=Data Source=/app/data/mailer.db
MAILER_MEM_LIMIT=512m
MAILER_CPUS=1.0
MAILER_STOP_GRACE_PERIOD=120s

# The base consumer network name remains required by compose.yml interpolation,
# but compose.shared-edge.yml removes that network from the Mailer service.
MAILER_NETWORK_NAME=amane_mailer
MAILER_NETWORK_ALIAS=mailer

# ── Shared platform edge ─────────────────────────────────────────────────────
# These addresses must belong to the existing external Docker network.
# Use the actual platform-edge proxy address and reserve a stable Mailer address.
MAILER_SHARED_EDGE_NETWORK_NAME=replace-with-existing-shared-edge-network
MAILER_SHARED_EDGE_ALIAS=mailer
MAILER_SHARED_EDGE_PROXY_IPV4_ADDRESS=172.31.0.2
MAILER_SHARED_EDGE_MAILER_IPV4_ADDRESS=172.31.0.3

# ── Protected provider / bounce paths ────────────────────────────────────────
MAILER_ACS_SECRET_HOST_PATH=./secrets/acs
MAILER_BOUNCE_QUEUE_SECRET_HOST_PATH=./secrets/bounce-queue
MAILER_BOUNCE_INGESTION=off
MAILER_BOUNCE_QUEUE_NAME=

# ── Health, metrics, and logging ─────────────────────────────────────────────
MAILER_HEALTHCHECK_INTERVAL=30s
MAILER_HEALTHCHECK_TIMEOUT=5s
MAILER_HEALTHCHECK_RETRIES=5
MAILER_HEALTHCHECK_START_PERIOD=20s
MAILER_METRICS_ENABLED=false
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ── Backup integration ───────────────────────────────────────────────────────
MAILER_BACKUP_ENCRYPTION_PUBLIC_KEY=replace-with-age-recipient-public-key
MAILER_BACKUP_RCLONE_REMOTE=remote:bucket-or-prefix/mailer/
MAILER_BACKUP_RCLONE_CONFIG_PATH=./rclone/rclone.conf
MAILER_BACKUP_REQUIRE_OFFSITE=true
MAILER_BACKUP_PING_URL=
MAILER_COMPOSE_FILE=compose.yml:compose.shared-edge.yml:compose.image-digest.yml
