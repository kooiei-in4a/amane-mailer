# Caddy reference edge template for the VPS dogfood deployment (Issue #744 / Source Stage).
#
# The renderer fills the JP CIDR and bcrypt markers into the ignored runtime artifact
# Caddyfile.vps-dogfood. It consumes operator-provided IPdeny aggregated JP zone files only; it does
# not download source data. Caddy enables automatic HTTPS
# for a real hostname. DNS, firewall rules, and the public TLS account remain operator-owned.
#
# MAILER_MANAGEMENT_ALLOWED_CIDRS remains the operator-only boundary for /metrics. It is not the
# browser Admin/Setup allow-list; that list is derived from IPdeny JP zones and rendered below.

{$MAILER_PUBLIC_HOSTNAME} {
	# Caddy's automatic HTTPS redirects HTTP to HTTPS for this named site.

	# The renderer replaces the two CIDR markers with deterministic, collapsed IPdeny ranges.
	# Each range becomes its own remote_ip line so the Caddyfile has no unbounded line.
	# This matcher intentionally excludes /metrics: its existing operator restriction is separate.
	@browser_jp {
		path /admin /admin/* /setup /setup/*
		{{JP_IPV4_CIDRS}}
		{{JP_IPV6_CIDRS}}
	}
	@browser_family {
		path /admin /admin/* /setup /setup/*
	}
	@metrics_operator {
		path /metrics
		remote_ip {$MAILER_MANAGEMENT_ALLOWED_CIDRS}
	}
	@metrics {
		path /metrics
	}
	@public path /api/* /healthz /readyz

	# Keep route order explicit: the JP+Basic route must be selected before the path-only 404,
	# and all of these handlers must remain mutually exclusive.
	route {
		# The edge Basic Auth is an additional gate. A successful edge login is not Mailer's own
		# Admin/Setup authentication; both layers remain enabled.
		handle @browser_jp {
			basic_auth {
				{{CADDY_BASIC_AUTH_USERNAME}} {{CADDY_BASIC_AUTH_BCRYPT_HASH}}
			}
			reverse_proxy mailer:8080 {
				# Never pass Caddy's Basic Authorization header to Mailer. Mailer retains its own
				# Admin/Setup authentication and session boundary.
				header_up -Authorization
				# Caddy is the only trusted forwarded-header source on vps_proxy. Set the scheme
				# from the actual TLS connection so client-supplied X-Forwarded-Proto is ignored.
				header_up X-Forwarded-Proto {scheme}
			}
		}

		# Non-JP requests receive 404 before Caddy can issue a Basic Auth challenge. Keep this
		# path-family handler immediately after the JP+Basic route.
		handle @browser_family {
			respond 404
		}

		# Metrics keeps the current operator CIDR boundary and Mailer's bearer authentication. Do not
		# replace this with the JP list or expose it to Japan as a whole.
		handle @metrics_operator {
			reverse_proxy mailer:8080 {
				header_up X-Forwarded-Proto {scheme}
			}
		}
		handle @metrics {
			respond 404
		}

		# Consumer API and liveness/readiness are the only public paths in this reference profile.
		handle @public {
			reverse_proxy mailer:8080 {
				header_up X-Forwarded-Proto {scheme}
			}
		}

		# Keep undocumented paths, including an accidental root/static surface, closed.
		handle {
			respond 404
		}
	}
}
