<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Amane.Mailer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Amane.Mailer\Amane.Mailer.csproj" />
    <ProjectReference Include="..\..\src\Amane.Mailer.Contracts\Amane.Mailer.Contracts.csproj" />
    <ProjectReference Include="..\Amane.Mailer.Spike526.Probe\Amane.Mailer.Spike526.Probe.csproj" />
    <ProjectReference Include="..\Amane.Mailer.ProcessFixture\Amane.Mailer.ProcessFixture.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyProcessFixtureToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_ProcessFixtureOutDir>$(MSBuildThisFileDirectory)..\Amane.Mailer.ProcessFixture\bin\$(Configuration)\$(TargetFramework)\</_ProcessFixtureOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_ProcessFixtureCopy Include="$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture.dll" />
      <_ProcessFixtureCopy Include="$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture.deps.json" />
      <_ProcessFixtureCopy Include="$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture.runtimeconfig.json" />
      <_ProcessFixtureCopy Include="$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture.exe"
                           Condition="Exists('$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture.exe')" />
      <_ProcessFixtureCopy Include="$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture"
                           Condition="Exists('$(_ProcessFixtureOutDir)Amane.Mailer.ProcessFixture')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProcessFixtureCopy)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_ProcessFixtureCopy)' != ''" />
  </Target>

  <Target Name="CopySpike526ProbeToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_Spike526ProbeOutDir>$(MSBuildThisFileDirectory)..\Amane.Mailer.Spike526.Probe\bin\$(Configuration)\$(TargetFramework)\</_Spike526ProbeOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_Spike526ProbeCopy Include="$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe.dll" />
      <_Spike526ProbeCopy Include="$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe.deps.json" />
      <_Spike526ProbeCopy Include="$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe.runtimeconfig.json" />
      <_Spike526ProbeCopy Include="$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe.exe"
                          Condition="Exists('$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe.exe')" />
      <_Spike526ProbeCopy Include="$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe"
                          Condition="Exists('$(_Spike526ProbeOutDir)Amane.Mailer.Spike526.Probe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_Spike526ProbeCopy)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_Spike526ProbeCopy)' != ''" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Amane.Mailer\Data\Migrations\*.sql" Link="Data\Migrations\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
